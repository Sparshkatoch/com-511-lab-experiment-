from cryptography import x509
from cryptography.x509.oid import NameOID
from cryptography.hazmat.primitives import hashes, serialization
from cryptography.hazmat.primitives.asymmetric import rsa
from datetime import datetime, timedelta, timezone

# Generate RSA key
private_key = rsa.generate_private_key(
    public_exponent=65537,
    key_size=2048
)

# Certificate information
identity = x509.Name([
    x509.NameAttribute(NameOID.COUNTRY_NAME, "IN"),
    x509.NameAttribute(NameOID.ORGANIZATION_NAME, "College"),
    x509.NameAttribute(NameOID.COMMON_NAME, "Sparsh")
])

# Create self-signed certificate
certificate = (
    x509.CertificateBuilder()
    .subject_name(identity)
    .issuer_name(identity)
    .public_key(private_key.public_key())
    .serial_number(x509.random_serial_number())
    .not_valid_before(datetime.now(timezone.utc))
    .not_valid_after(datetime.now(timezone.utc) + timedelta(days=365))
    .sign(private_key, hashes.SHA256())
)

# Save private key
with open("private_key.pem", "wb") as file:
    file.write(private_key.private_bytes(
        serialization.Encoding.PEM,
        serialization.PrivateFormat.PKCS8,
        serialization.NoEncryption()
    ))

# Save certificate
with open("certificate.pem", "wb") as file:
    file.write(certificate.public_bytes(serialization.Encoding.PEM))

# Display important details
print("X.509 Certificate Created Successfully")
print("Subject :", certificate.subject)
print("Issuer  :", certificate.issuer)
print("Serial  :", certificate.serial_number)
print("Valid Until:", certificate.not_valid_after_utc)
